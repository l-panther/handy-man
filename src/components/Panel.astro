---
import { COMPANY_NAME } from '../lib/config.js';
import { asset } from '../utils/paths';
---

<div class="mobile-panel" id="mobilePanel">
  <div class="mobile-panel-head">
    <div class="brand">
      <div class="brand-mark">HS</div>
      <div class="brand-name">{COMPANY_NAME}</div>
    </div>
    <button class="mobile-close" id="mobileClose" aria-label="Close menu">✕</button>
  </div>
  <nav class="mobile-links">
    <a href={asset('')}>Home</a>
    <a href={asset('#about')}>About</a>
    <a href={asset('#services')}>Services</a>
    <a href={asset('#contact')}>Contact</a>
  </nav>
  <div class="mobile-cta"><a href="#contact">Get a quote</a></div>
</div>
