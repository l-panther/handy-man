---
import { COMPANY_NAME } from '../lib/config.js';
---


<section class="hero">
  <div class="hero-overlay"></div>

  <div class="wrap hero-content">
    <h1>
      Quality workmanship<br>
      <em>you can trust.</em>
    </h1>

    <p>
      From electrical repairs and plumbing to flooring and decorating, {COMPANY_NAME} delivers reliable home improvements with
      professional results, every time.
    </p>

    <div class="hero-actions">
      <a href="#contact" class="btn btn-primary">
        Get your free quote
      </a>

      <a href="#services" class="btn btn-outline">
        Explore our services
      </a>
    </div>
  </div>
</section>

<style>


  .hero {
    position: relative;
    min-height: 700px;
    display: flex;
    align-items: center;
    background-image: url('./assets/images/hero/hero.jpg');
    background-size: cover;
    background-position: center;
    color: white;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0,0,0,.75),
      rgba(0,0,0,.35)
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    width: 1180px;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 1.05;
    margin-bottom: 25px;
    max-width: 800px;
  }

  .hero h1 em {
    color: #f39c12;
    font-style: normal;
  }

  .hero p {
    font-size: 1.25rem;
    line-height: 1.7;
    max-width: 650px;
    margin-bottom: 35px;
  }

  .hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:40px;}

  @media (max-width: 760px){
    .hero{padding:64px 0 56px;}
    .hero h1{font-size:36px;}

    .hero {
      min-height: 600px;
      background-position:center;
    }

    .hero-content {
      text-align:center;
    }

    .hero-actions {
      justify-content:center;
      flex-wrap:wrap;
    }

  }

  @media (max-width: 980px){
    .hero-grid,.about-grid,.contact-grid{grid-template-columns:1fr;}
    .hero-panel{order:-1;}
  }
</style>
