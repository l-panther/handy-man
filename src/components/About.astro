---
import { asset } from '../utils/paths';
import { COMPANY_NAME } from '../lib/config.js';
---

<section id="about">
  <div class="wrap about-grid">

    <div class="about-visual">
        <img src={asset('assets/images/about/about.jpg')} alt="Home improvement">
    </div>

    <div class="about-copy">

      <span class="eyebrow">Why homeowners choose us</span>

      <h2 style="font-size:30px;margin-bottom:16px;">
        Honest work.<br>
        Quality results.
      </h2>

      <p>
        {COMPANY_NAME} was built on a simple promise: deliver reliable
        workmanship and treat every home as if it was our own. From small repairs
        to larger improvement projects, we take pride in doing the job properly,
        communicating clearly, and leaving every space clean and tidy.
      </p>

      <ul class="about-list">
        <li>
          
          <span>Skilled professionals with practical experience across a wide range of home improvement services.</span>
        </li>

        <li>
          
          <span>Detailed quotes with no hidden surprises before any work begins.</span>
        </li>

        <li>
          <span>We protect your property, minimise disruption and leave everything clean when finished.</span>
        </li>

        <li>
          
          <span>All work completed with care and backed by our commitment to quality.</span>
        </li>
      </ul>

    </div>

  </div>
</section>


<style>
  /* ---------- About ---------- */
#about{background: var(--text);}
#about h2{color: var(--bg);}
.about-grid{
  display:grid;grid-template-columns:0.9fr 1.1fr;
  gap:60px;align-items:center;
}
.about-visual img{
  border-radius:2px;
  width: 100%
}
.about-metric{
  background:var(--surface);padding:22px 18px;
}
.about-metric .num{font-family:'Space Grotesk',sans-serif;font-size:28px;color:var(--accent);font-weight:700;}
.about-metric .label{font-size:11.5px;color:var(--text-faint);text-transform:uppercase;letter-spacing:0.06em;margin-top:4px;}
.about-copy p{color:var(--card);font-size:15px;margin-bottom:16px;}
.about-copy ul{margin-top:20px;display:flex;flex-direction:column;gap:12px;}
.about-copy li{
  font-size:14px;color:var(--card);
  display:flex;align-items:center;gap:10px;;
}
.about-copy li span { padding-left: 20px;}
.about-copy li::before{
  content:'✓';color:var(--accent);font-weight:700;
  width:35px;height:35px;border:1px solid var(--accent);border-radius:50%;
  display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;
}

</style>
