---
import { asset } from '../utils/paths';
import { COMPANY_NAME } from '../lib/config.js';
---

<section id="about">
  <div class="wrap about-grid">

   <!-- <div class="about-visual">
        <img src={asset('assets/images/about/about.jpg')} alt="Home improvement">
    </div>-->

    <div class="about-visual">
  <div class="about-collage">
    <img
      src={asset('assets/images/about/electrical.webp')}
      alt="Electrical work"
    />

    <img
      src={asset('assets/images/about/plumbing.webp')}
      alt="Plumbing work"
    />

    <img
      src={asset('assets/images/about/flooring.webp')}
      alt="Flooring installation"
    />

    <img
      src={asset('assets/images/about/painting.webp')}
      alt="Interior decorating"
    />

    <img
      src={asset('assets/images/about/ceiling.webp')}
      alt="Completed home improvement"
    />
  </div>
</div>

    <div class="about-copy">

      <span class="eyebrow">Why homeowners choose us</span>

      <h2 style="font-size:30px;margin-bottom:16px;">
        Honest work.<br>
        Quality results.
      </h2>

      <p>
        {COMPANY_NAME} was built on a simple promise: deliver reliable
        workmanship and treat every home as if it was our own. From small repairs
        to larger improvement projects, we take pride in doing the job properly,
        communicating clearly, and leaving every space clean and tidy.
      </p>

      <ul class="about-list">
        <li>
          
          <span>Skilled professionals with practical experience across a wide range of home improvement services.</span>
        </li>

        <li>
          
          <span>Detailed quotes with no hidden surprises before any work begins.</span>
        </li>

        <li>
          <span>We protect your property, minimise disruption and leave everything clean when finished.</span>
        </li>

        <li>
          
          <span>All work completed with care and backed by our commitment to quality.</span>
        </li>
      </ul>

    </div>

  </div>
</section>


<style>

/* -------------------------
   ABOUT
-------------------------- */

#about {
  background: var(--text);
}

#about h2 {
  color: var(--bg);
}

.about-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 60px;
  align-items: center;
}


/* -------------------------
   ABOUT IMAGE COLLAGE
-------------------------- */

.about-collage {
  /* Easy customisation */
  --collage-gap: 8px;
  --collage-border: 1.5px;
  --collage-border-color: #d1d1d1;
  --collage-radius: 3px;

  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: var(--collage-gap);
  width: 100%;
}

/* All images */
.about-collage img {
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  object-fit: cover;

  border: var(--collage-border) solid var(--collage-border-color);
  border-radius: var(--collage-radius);

  box-sizing: border-box;
}

/* Top row: 3 images */
.about-collage img:nth-child(1),
.about-collage img:nth-child(2),
.about-collage img:nth-child(3) {
  grid-column: span 2;
  height: 290px;
}

/* Bottom row: 2 images */
.about-collage img:nth-child(4),
.about-collage img:nth-child(5) {
  grid-column: span 3;
  height: 170px;
}

/* Individual image positioning */
.about-collage img:nth-child(1) {
  object-position: 50% 50%;
}

.about-collage img:nth-child(2) {
  object-position: 50% 50%;
}

.about-collage img:nth-child(3) {
  object-position: 50% 50%;
}

.about-collage img:nth-child(4) {
  object-position: 50% 50%;
}

.about-collage img:nth-child(5) {
  object-position: 50% 50%;
}


/* -------------------------
   TABLET
-------------------------- */

@media (max-width: 991px) {
  .about-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .about-visual {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .about-copy {
    width: 100%;
  }
}

/* -------------------------
   MOBILE
-------------------------- */

@media (max-width: 760px) {
  .about-collage img:nth-child(-n+3) {
    height: 210px;
  }

  .about-collage img:nth-child(n+4) {
    height: 150px;
  }
}

/* -------------------------
   MOBILE
-------------------------- */

@media (max-width: 575px) {
  .about-grid {
    gap: 30px;
  }

  .about-copy h2 {
    font-size: 28px !important;
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .about-copy p {
    font-size: 14px;
    line-height: 1.75;
  }

  .about-copy ul {
    margin-top: 24px;
    gap: 16px;
  }

  .about-copy li {
    align-items: flex-start;
    gap: 12px;
    font-size: 13.5px;
  }

  .about-copy li::before {
    width: 30px;
    height: 30px;
    font-size: 18px;
  }
}


@media (max-width: 400px) {
  .about-collage {
    --collage-gap: 5px;
  }

  .about-collage img:nth-child(-n+3) {
    height: 160px;
  }

  .about-collage img:nth-child(n+4) {
    height: 120px;
  }
}


.about-copy {
  min-width: 0;
}

.about-copy p {
  color: var(--card);
  font-size: 15px;
  line-height: 1.75;
  margin-bottom: 16px;
}

.about-copy ul {
  margin-top: 20px;
  padding: 0;
  list-style: none;

  display: flex;
  flex-direction: column;
  gap: 12px;
}

.about-copy li {
  display: flex;
  align-items: center;
  gap: 14px;

  font-size: 14px;
  line-height: 1.6;
  color: var(--card);
}

.about-copy li span {
  flex: 1;
  min-width: 0;
}

.about-copy li::before {
  content: '✓';

  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;

  width: 35px;
  height: 35px;

  color: var(--accent);
  border: 1px solid var(--accent);
  border-radius: 50%;

  font-size: 22px;
  font-weight: 700;
}

</style>
