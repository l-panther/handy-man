  <section id="about">
  <div class="wrap about-grid">

    <div class="about-visual">
        <img src={asset('assets/images/about/about.jpg')} alt="Home improvement">
    </div>

    <div class="about-copy">

      <span class="eyebrow">Why homeowners choose us</span>

      <h2 style="font-size:30px;margin-bottom:16px;">
        Honest work.<br>
        Quality results.
      </h2>

      <p>
        {COMPANY_NAME} was built on a simple promise: deliver reliable
        workmanship and treat every home as if it was our own. From small repairs
        to larger improvement projects, we take pride in doing the job properly,
        communicating clearly, and leaving every space clean and tidy.
      </p>

      <ul class="about-list">
        <li>
          
          <span>Skilled professionals with practical experience across a wide range of home improvement services.</span>
        </li>

        <li>
          
          <span>Detailed quotes with no hidden surprises before any work begins.</span>
        </li>

        <li>
          <span>We protect your property, minimise disruption and leave everything clean when finished.</span>
        </li>

        <li>
          
          <span>All work completed with care and backed by our commitment to quality.</span>
        </li>
      </ul>

    </div>

  </div>
</section>

