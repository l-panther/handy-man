---
const testimonials = [
  {
    quote: "Rewired our kitchen and laid new vinyl flooring in the same week. Everything was labeled, cleaned up, and explained clearly before they left.",
    name: "Marta Oyelaran",
    role: "Camden"
  },
  {
    quote: "Found a slow leak two other plumbers missed. Fixed same afternoon and the quote didn't move once the job was underway.",
    name: "Devon Whitlock",
    role: "Croydon"
  },
  {
    quote: "Repainted the whole downstairs and patched up years of nail holes. Sharpest cut lines I've seen from any painter we've hired.",
    name: "Priya Chandrasekar",
    role: "Stratford"
  }
]
---

<section id="testimonials">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">cLIENT feedback</div>
      <h2>What our customers say.</h2>
    </div>
    <div class="testi-grid">

      {testimonials.map((item) => (
        <div class="testi-card">
          <p class="testi-quote">{item.quote}</p>
          <div class="testi-name">{item.name}</div>
          <div class="testi-role">{item.role}</div>
        </div>
      ))}
      
    </div>
  </div>
</section>

<style>
  /* ---------- Testimonials ---------- */
#testimonials{background:var(--text);border-top:1px solid var(--accent-dim);border-bottom:1px solid var(--line-soft);}
#testimonials h2{color: var(--bg);}
.testi-grid{
  display:grid;grid-template-columns:repeat(3, 1fr);gap:22px;
}
.testi-card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:8px;
  padding:26px;
}
.testi-quote{font-size:14.5px;color:var(--text-dim);margin-bottom:20px;}
.testi-name{font-size:13.5px;font-weight:600;}
.testi-role{font-size:12px;color:var(--accent);}

@media (max-width: 980px){
  .testi-grid{grid-template-columns:1fr;}
}
</style>
