---
import { asset } from '../utils/paths';
import { services as trades } from '../data/services';
---

<section id="services">
  <div class="wrap">

    <div class="section-head">
      <div class="eyebrow">What we do</div>

      <h2>Home improvements, one trusted team.</h2>

      <p>
        From repairs and upgrades to full home improvements,
        our skilled tradespeople work together to deliver
        reliable, high-quality results without the hassle
        of managing multiple contractors.
      </p>
    </div>

    <div class="service-grid">
      {trades.map((trade) => (
        <article class="service-card">

          <img
            src={asset(trade.image)}
            alt={`${trade.name} services`}
            loading="lazy"
          />

          <div class="card-content">

            <h3>{trade.name}</h3>

            <p>{trade.description}</p>

            <ul class="service-list">
              {trade.services.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <a
              href={asset(`services/${trade.slug}/`)}
              class="service-link"
              aria-label={`Explore ${trade.name} services`}
            >
              Explore Service
              <span aria-hidden="true">↗</span>
            </a>

          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style>

/* ---------- Services ---------- */
#services{border-bottom:1px solid var(--accent-dim);background:var(--accent);}
#services p {color: var(--surface);}
#services .eyebrow { color: var(--card);}
#services .eyebrow::before{background:var(--card);}
.service-grid{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:1px;
  background:var(--accent);
  border:1px solid var(--text-dim);
  border-radius:8px;
  overflow:hidden;
}

.service-card img {
  display: block;
  width: 100%;
  height: 180px;
  object-fit: cover;
}

.service-card{
  background:var(--text);
  transition:background .15s ease;
}
.card-content{
  padding:30px 26px;
}
.service-card:hover{background:#eaeaea;}
.service-icon{
  width:42px;height:42px;
  border-radius:var(--radius);
  background:rgba(240,162,2,0.12);
  color:var(--accent);
  display:flex;align-items:center;justify-content:center;
  margin-bottom:20px;
}
.service-card h3{font-size:18px;font-weight:bold;margin:10px 0; color: var(--surface);}
.service-card p{font-size:13.5px;color:var(--text-dim);margin-bottom:16px;}
.service-list{display:flex;flex-direction:column;gap:7px;}
.service-list li{
  font-size:12.5px;color:var(--text-faint);
  display:flex;align-items:center;gap:8px;
}
.service-list li::before{
  content:'';width:5px;height:5px;background:var(--accent);border-radius:50%;flex-shrink:0;
}

/* SERVICE CARD LAYOUT */

.service-card {
  display: flex;
  flex-direction: column;
}

.service-card .card-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

/* Push link to the bottom */

.service-card .service-list {
  margin-bottom: 24px;
}

/* Explore service link */

.service-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  margin-top: auto;
  padding-top: 18px;

  border-top: 1px solid rgba(0, 0, 0, 0.12);

  color: #242424;
  font-size: 0.9rem;
  font-weight: 700;
  text-decoration: none;

  transition: color 0.2s ease;
}

.service-link span {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 32px;
  height: 32px;

  border-radius: 50%;
  background: #f2a900;
  color: #242424;

  font-size: 1.1rem;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.service-link:hover {
  color: #c47d00;
}

.service-link:hover span {
  background: #ffc247;
  transform: translate(2px, -2px);
}

.service-link:focus-visible {
  outline: 2px solid #242424;
  outline-offset: 4px;
}


/* -------------------------
   TABLET
-------------------------- */

@media (max-width: 980px) {
  .service-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card-content {
    padding: 26px 22px;
  }
}

/* -------------------------
   MOBILE
-------------------------- */

@media (max-width: 760px) {
  .service-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .service-card {
    min-width: 0;
  }

  .service-card img {
    display: block;
    width: 100%;
    height: 210px;
    object-fit: cover;
  }

  .card-content {
    padding: 24px 22px;
  }

  .service-card h3 {
    font-size: 18px;
  }

  .service-card p {
    font-size: 14px;
    line-height: 1.65;
  }

  .service-list {
    gap: 9px;
  }

  .service-list li {
    font-size: 13px;
    line-height: 1.5;
  }

  .service-link {
    padding-top: 16px;
    font-size: 13px;
  }
}

/* -------------------------
   SMALL MOBILE
-------------------------- */

@media (max-width: 400px) {
  .card-content {
    padding: 22px 18px;
  }

  .service-card img {
    height: 185px;
  }
}

</style>
