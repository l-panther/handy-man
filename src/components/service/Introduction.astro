---
import { services } from '../../data/services';
import { asset } from '../../utils/paths';
export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}
const { service } = Astro.props;

const homeUrl = import.meta.env.BASE_URL;
const servicesUrl = `${homeUrl}#services`;
const contactUrl = `${homeUrl}#contact`;
---

<!-- INTRODUCTION -->
<section class="service-intro">
  <div class="wrap service-intro-grid">

    <div class="service-intro-image">
      <img
        src={asset(service.image)}
        alt={`${service.name} services`}
      />
    </div>

    <div class="service-intro-content">
      <span class="service-eyebrow">
        What We Do
      </span>

      <h2>About Our {service.name} Services</h2>

      <p>{service.introduction}</p>

      <a href={contactUrl} class="service-btn">
        Request a Quote
        <span aria-hidden="true">↗</span>
      </a>
    </div>

  </div>
</section>