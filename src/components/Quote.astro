---
import { COMPANY_EMAIL, COMPANY_TELEPHONE, COMPANY_LOCATION } from '../lib/config.js';
---

<section id="contact">
  <div class="wrap contact-grid">
    <div>
      <div class="eyebrow">Get in touch</div>
      <h2 style="font-size:30px;margin-bottom:20px;">Tell us what needs fixing.</h2>
      <p style="color:var(--text-dim);font-size:15px;margin-bottom:30px;max-width:400px;">Send a few details and we'll get back to you same day with a quote or a scheduled call-out.</p>
      <div class="contact-info-item">
        <div class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .6 3a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c1 .3 2 .5 3 .6a2 2 0 0 1 1.7 2z"/></svg></div>
        <div><h4>Call or text</h4><a class="phone-link" href={`tel:${COMPANY_TELEPHONE}`}>{COMPANY_TELEPHONE}</a></div>
      </div>
      <div class="contact-info-item">
        <div class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M22 6 12 13 2 6"/></svg></div>
        <div><h4>Email</h4><a class="email-link" href={`mailto:${COMPANY_EMAIL}`}>{COMPANY_EMAIL}</a></div>
      </div>
      <div class="contact-info-item">
        <div class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-6.5 7-11a7 7 0 1 0-14 0c0 4.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></div>
        <div><h4>Service area</h4><p>{COMPANY_LOCATION}</p></div>
      </div>
      <div class="contact-info-item">
        <div class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
        <div><h4>Hours</h4><p>Mon–Sat, 7am–6pm</p></div>
      </div>
    </div>

    <div class="form-card">
      <form id="contactForm" novalidate aria-describedby="formStatus">
        <!-- Success/error alert panel, shown above the form fields -->
        <div id="formAlert" class="form-alert" role="alert" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>
          </svg>
          <span id="formAlertText"></span>
          <button type="button" id="formAlertClose" aria-label="Dismiss">&times;</button>
        </div>

        <div class="form-two">
          <div class="form-row">
            <label for="name">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Your full name"
              required
              aria-required="true"
              aria-describedby="name-error"
            />
            <p id="name-error" class="field-error" role="alert"></p>
          </div>
          <div class="form-row">
            <label for="phone">Phone</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="(555) 000-0000"
              required
              aria-required="true"
              aria-describedby="phone-error"
            />
            <p id="phone-error" class="field-error" role="alert"></p>
          </div>
        </div>

        <div class="form-row">
          <label for="service">Service needed</label>
          <select id="service" name="service" required aria-required="true" aria-describedby="service-error">
            <option value="" disabled selected>Select a service...</option>
            <option>Electrical</option>
            <option>Flooring</option>
            <option>Plumbing</option>
            <option>Decorating</option>
            <option>Something else</option>
          </select>
          <p id="service-error" class="field-error" role="alert"></p>
        </div>

        <div class="form-row">
          <label for="message">Details</label>
          <textarea
            id="message"
            name="message"
            maxlength="400"
            placeholder="Tell us what's going on and when works best for a visit."
            required
            aria-required="true"
            aria-describedby="message-error charCount-wrap"
          ></textarea>
          <div class="message-meta-row">
            <p id="message-error" class="field-error" role="alert"></p>
            <div class="char-count" id="charCount-wrap"><span id="charCount">0</span>/400</div>
          </div>
        </div>

        <button type="submit" class="form-submit">
          <span class="btn-label">Request a quote</span>
          <span class="btn-spinner" aria-hidden="true"></span>
        </button>
        <p class="form-note">We reply within one business day. No spam, ever.</p>

        <p id="formStatus" class="visually-hidden" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const textarea = document.getElementById('message') as HTMLTextAreaElement | null;
  const count = document.getElementById('charCount');
  textarea?.addEventListener('input', () => {
    if (count) count.textContent = String(textarea.value.length);
  });

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const formStatus = document.getElementById('formStatus');
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  const alertPanel = document.getElementById('formAlert');
  const alertText = document.getElementById('formAlertText');
  const alertClose = document.getElementById('formAlertClose');

  type FieldName = 'name' | 'phone' | 'service' | 'message';

  const fields: Record<FieldName, HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null> = {
    name: document.getElementById('name') as HTMLInputElement | null,
    phone: document.getElementById('phone') as HTMLInputElement | null,
    service: document.getElementById('service') as HTMLSelectElement | null,
    message: document.getElementById('message') as HTMLTextAreaElement | null,
  };

  const validators: Record<FieldName, (value: string) => string> = {
    name(value: string) {
      const v = value.trim();
      if (!v) return 'Please enter your name.';
      if (v.length < 2) return 'Name must be at least 2 characters.';
      if (!/^[a-zA-Z\s'-]+$/.test(v)) return 'Name can only contain letters, spaces, hyphens and apostrophes.';
      return '';
    },
    phone(value: string) {
      const v = value.trim();
      if (!v) return 'Please enter a phone number.';
      const phonePattern = /^[+]?[\d\s()-]{7,20}$/;
      if (!phonePattern.test(v)) return 'Please enter a valid phone number.';
      return '';
    },
    service(value: string) {
      const v = value.trim();
      if (!v) return 'Please select a service.';
      return '';
    },
    message(value: string) {
      const v = value.trim();
      if (!v) return 'Please add some details.';
      if (v.length < 10) return 'Please add a bit more detail (at least 10 characters).';
      if (v.length > 400) return 'Details cannot exceed 400 characters.';
      return '';
    },
  };

  function setFieldError(name: FieldName, message: string) {
    const input = fields[name];
    const errorEl = document.getElementById(`${name}-error`);
    if (!input || !errorEl) return;

    if (message) {
      input.classList.add('is-invalid');
      input.classList.remove('is-valid');
      input.setAttribute('aria-invalid', 'true');
      errorEl.textContent = message;
    } else {
      input.classList.remove('is-invalid');
      input.classList.add('is-valid');
      input.setAttribute('aria-invalid', 'false');
      errorEl.textContent = '';
    }
  }

  function validateField(name: FieldName): boolean {
    const input = fields[name];
    if (!input) return true;
    const error = validators[name](input.value);
    setFieldError(name, error);
    return !error;
  }

  const fieldNames = Object.keys(fields) as FieldName[];

  fieldNames.forEach((name) => {
    const input = fields[name];
    input?.addEventListener('blur', () => validateField(name));
    input?.addEventListener('input', () => {
      if (input.classList.contains('is-invalid')) validateField(name);
    });
    if (input instanceof HTMLSelectElement) {
      input.addEventListener('change', () => validateField(name));
    }
  });

  function validateAll(): boolean {
    let isValid = true;

    fieldNames.forEach((name) => {
      if (!validateField(name)) isValid = false;
    });

    if (!isValid) {
      const firstInvalidName = fieldNames.find((name) => {
        const input = fields[name];
        return input?.classList.contains('is-invalid');
      });
      if (firstInvalidName) fields[firstInvalidName]?.focus();
    }

    return isValid;
  }

  // Simulates a server-side round trip (fake site — no real endpoint).
  function fakeServerSubmit(formData: Record<string, string>): Promise<{ ok: boolean }> {
    return new Promise((resolve) => {
      setTimeout(() => resolve({ ok: true }), 800);
    });
  }

  function showAlert(message: string, tone: 'success' | 'error' = 'success') {
    if (!alertPanel || !alertText) return;
    alertText.textContent = message;
    alertPanel.classList.remove('form-alert--success', 'form-alert--error');
    alertPanel.classList.add(tone === 'success' ? 'form-alert--success' : 'form-alert--error');
    alertPanel.hidden = false;
  }

  function hideAlert() {
    if (alertPanel) alertPanel.hidden = true;
  }

  alertClose?.addEventListener('click', hideAlert);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    hideAlert();
    if (formStatus) formStatus.textContent = '';

    if (!validateAll()) {
      if (formStatus) formStatus.textContent = 'Please fix the highlighted fields before submitting.';
      return;
    }

    submitBtn?.classList.add('is-loading');
    submitBtn?.setAttribute('disabled', 'true');

    const formData = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    const result = await fakeServerSubmit(formData);

    submitBtn?.classList.remove('is-loading');
    submitBtn?.removeAttribute('disabled');

    if (result.ok) {
      if (formStatus) formStatus.textContent = 'Your request has been sent successfully.';
      showAlert('Thanks — we\'ve got your details and will be in touch within one business day.', 'success');
      form.reset();
      if (count) count.textContent = '0';
      fieldNames.forEach((name) => {
        fields[name]?.classList.remove('is-valid', 'is-invalid');
        const errorEl = document.getElementById(`${name}-error`);
        if (errorEl) errorEl.textContent = '';
      });
      alertPanel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      if (formStatus) formStatus.textContent = 'Something went wrong. Please try again.';
      showAlert('Something went wrong sending your request. Please try again.', 'error');
    }
  });
</script>
